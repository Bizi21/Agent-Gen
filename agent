#!/usr/bin/env bash
# Agent-Gen — single command launcher.
#
#   ./agent            -> open the desktop window (chat is the first screen)
#   ./agent eval       -> run the eval suite
#   ./agent improve    -> run the self-improvement loop
#   ./agent run "task" -> run one task
set -euo pipefail
cd "$(dirname "$0")"
exec python3 -m agent_gen "$@"
