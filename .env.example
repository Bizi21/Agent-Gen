# ==============================================================================
#  Agent-Gen — .env  (copy this template to your own `.env` and fill it in)
# ==============================================================================
#  Add ANY provider, ANY model, ANY endpoint. There is NO hardcoded list —
#  the agent only enables the providers whose keys you set here. Leave a block
#  blank to disable that provider.
#
#  `0` (or `none`) means "no limit" wherever a limit appears.
# ==============================================================================

# -----------------------------------------------------------------------------
# Default provider / model (first adapter tried when none is specified)
# -----------------------------------------------------------------------------
AGENT_GEN_PROVIDER=openai
AGENT_GEN_MODEL=auto                 # auto = provider default; or name any model

# -----------------------------------------------------------------------------
# Provider API keys — add as many as you like (any provider)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=                     # optional override, e.g. https://api.openai.com/v1

ANTHROPIC_API_KEY=

GOOGLE_API_KEY=                      # Gemini

MISTRAL_API_KEY=

GROQ_API_KEY=

DEEPSEEK_API_KEY=

COHERE_API_KEY=

OPENROUTER_API_KEY=                  # one key -> hundreds of models

TOGETHER_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# -----------------------------------------------------------------------------
# Local / self-hosted models (Ollama, LM Studio, vLLM, llama.cpp, ...)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=                        # e.g. llama3.1, qwen2.5, mistral, gemma2

# Any OpenAI-compatible server (LM Studio, vLLM, Together, Groq, custom, ...)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# -----------------------------------------------------------------------------
# Per-capability model routing (any capability -> any provider/model).
# Comma-separated "provider/model". Blank = use AGENT_GEN_PROVIDER/MODEL.
# -----------------------------------------------------------------------------
AGENT_GEN_MODEL_CHAT=
AGENT_GEN_MODEL_REFLECT=
AGENT_GEN_MODEL_SUMMARIZE=
AGENT_GEN_MODEL_JUDGE=
AGENT_GEN_MODEL_VISION=
AGENT_GEN_MODEL_EMBEDDING=

# -----------------------------------------------------------------------------
# Long conversation & long context
# -----------------------------------------------------------------------------
AGENT_GEN_MAX_CONTEXT_TOKENS=0       # 0 = unlimited (use provider's max window)
AGENT_GEN_CONVERSATION_MEMORY=on     # on = remember and continue long conversations
AGENT_GEN_AUTO_SUMMARIZE_AT=0        # 0 = never; else compact history past N tokens

# -----------------------------------------------------------------------------
# Autonomy / freedom to think and work
# -----------------------------------------------------------------------------
AGENT_GEN_AUTONOMY=full              # assisted | semi | auto | full
AGENT_GEN_MAX_STEPS=0                # 0 = no limit on agent steps
AGENT_GEN_MAX_COST=0                 # 0 = no spending limit (USD)
AGENT_GEN_RATE_LIMIT=0               # 0 = no rate limit (calls/min)
AGENT_GEN_ALLOW_SELF_IMPROVE=on      # on = agent may improve itself freely
AGENT_GEN_FREE_THINK=on              # on = agent may reason/reflect openly at length

# -----------------------------------------------------------------------------
# Multilingual
# -----------------------------------------------------------------------------
AGENT_GEN_LANGUAGES=en,hi            # add any BCP-47 codes (en, hi, fr, es, ...)
AGENT_GEN_DEFAULT_LANG=auto          # auto-detect; or pin (en, hi, ...)

# -----------------------------------------------------------------------------
# Desktop window (the GUI that opens when the agent runs)
# -----------------------------------------------------------------------------
AGENT_GEN_UI_AUTO_OPEN=on            # on = open the window automatically on run
AGENT_GEN_UI_PORT=0                  # 0 = auto-pick a free port
AGENT_GEN_UI_TITLE=Agent-Gen

# -----------------------------------------------------------------------------
# Second brain (Obsidian vault + graph view)
# -----------------------------------------------------------------------------
AGENT_GEN_VAULT_PATH=./brain/vault   # path to the Obsidian vault (your second brain)
AGENT_GEN_OPEN_IN_OBSIDIAN=off       # on = also launch Obsidian pointed at the vault
AGENT_GEN_GRAPH_VIEW=on              # on = enable the "graphify" knowledge graph
